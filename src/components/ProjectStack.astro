---
import { projects } from "../data/projects";

const fanProjects = projects.map((project) => ({
  name: project.name,
  slug: project.slug,
  logo: project.logo,
  description: project.description,
}));
---

<div class="project-stack project-stack--desktop" role="group" aria-label="Favorite projects" data-project-stack>
  {
    projects.map((project, index) => (
      <a
        class="project-stack__item"
        href={`/projects/${project.slug}/`}
        data-astro-prefetch="load"
        aria-label={`${project.name}: ${project.description}`}
        style={`--project-index: ${index}; --project-tilt: ${project.angle}deg;`}
      >
        <span class="project-stack__logo-frame">
          <img
            class="project-stack__logo"
            src={project.logo}
            alt={project.alt}
            data-project-logo={project.slug}
            style={`view-transition-name: project-logo-${project.slug};`}
            width="384"
            height="384"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span class="project-stack__detail">
          <span class="project-stack__name">{project.name}</span>
          <span class="project-stack__description">{project.description}</span>
        </span>
      </a>
    ))
  }
</div>

<div
  class="project-fan"
  data-project-fan
  role="group"
  aria-label="Favorite projects. Swipe or use the arrow keys to browse, then open the one in front."
>
  <span class="project-fan__word" data-project-fan-word aria-hidden="true">{fanProjects[0].name}</span>

  <div class="project-fan__stage" data-project-fan-gesture>
    <div class="project-fan__marks">
      {
        fanProjects.map((project, index) => (
          <a
            class:list={["project-fan__mark", { "is-active": index === 0 }]}
            href={`/projects/${project.slug}/`}
            draggable="false"
            data-project-fan-mark
            data-index={index}
            data-offset={index === 0 ? "0" : index === 1 ? "1" : "-1"}
            aria-label={`${project.name}: ${project.description}`}
            aria-current={index === 0 ? "true" : undefined}
          >
            <img
              src={project.logo}
              alt=""
              draggable="false"
              width="112"
              height="112"
              loading="eager"
              decoding="async"
              data-project-logo={project.slug}
              style={index === 0 ? `view-transition-name: project-logo-${project.slug};` : undefined}
            />
          </a>
        ))
      }
    </div>

    <div class="project-fan__copy" data-project-fan-copy aria-live="polite">
      <strong data-project-fan-name>{fanProjects[0].name}</strong>
      <span data-project-fan-description>{fanProjects[0].description}</span>
    </div>
  </div>

</div>

<script is:inline>
  (() => {
    const stack = document.querySelector("[data-project-stack]");
    if (!stack || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const doc = document.documentElement;
    const storageKey = "kausthubh:stack:rollcall";
    const rollcallMs = 3400;
    try {
      if (window.sessionStorage.getItem(storageKey) === "1") return;
    } catch {
      return;
    }

    // Once someone has played with the stack it has done its job.
    const settle = () => stack.classList.remove("is-rollcall", "is-nudging");
    stack.addEventListener("pointerenter", settle, { once: true });
    stack.addEventListener("focusin", settle, { once: true });

    const begin = () => {
      if (stack.matches(":hover, :focus-within")) return;
      try {
        window.sessionStorage.setItem(storageKey, "1");
      } catch {
        return;
      }
      stack.classList.add("is-rollcall");
      window.setTimeout(() => {
        if (stack.classList.contains("is-rollcall")) stack.classList.replace("is-rollcall", "is-nudging");
      }, rollcallMs);
    };

    if (doc.dataset.introState === "done") {
      window.setTimeout(begin, 700);
      return;
    }
    const observer = new MutationObserver(() => {
      if (doc.dataset.introState !== "done") return;
      observer.disconnect();
      window.setTimeout(begin, 450);
    });
    observer.observe(doc, { attributes: true, attributeFilter: ["data-intro-state"] });
  })();
</script>

<script is:inline define:vars={{ fanProjects }}>
  (() => {
    const fan = document.querySelector("[data-project-fan]");
    if (!fan) return;

    const marks = [...fan.querySelectorAll("[data-project-fan-mark]")];
    const word = fan.querySelector("[data-project-fan-word]");
    const name = fan.querySelector("[data-project-fan-name]");
    const description = fan.querySelector("[data-project-fan-description]");
    const copy = fan.querySelector("[data-project-fan-copy]");
    const gesture = fan.querySelector("[data-project-fan-gesture]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let active = 0;
    let morphEnabled = true;
    let pointerStart = null;
    let didSwipe = false;

    const stackLogos = [...document.querySelectorAll(".project-stack--desktop [data-project-logo]")];

    const wrap = (value) => (value + fanProjects.length) % fanProjects.length;

    // Only one logo per project may claim the shared name, so the fan hands it
    // to whichever mark is selected. Whichever list is hidden sits this out.
    const applyMorphNames = () => {
      marks.forEach((mark, index) => {
        const image = mark.querySelector("img");
        image.style.viewTransitionName =
          morphEnabled && index === active ? `project-logo-${fanProjects[index].slug}` : "none";
      });
      stackLogos.forEach((image) => {
        image.style.viewTransitionName = morphEnabled ? `project-logo-${image.dataset.projectLogo}` : "none";
      });
    };

    const setActive = (next, options = {}) => {
      active = wrap(next);
      const project = fanProjects[active];

      marks.forEach((mark, index) => {
        let offset = index - active;
        if (offset > 1) offset -= fanProjects.length;
        if (offset < -1) offset += fanProjects.length;

        const selected = index === active;
        mark.dataset.offset = String(offset);
        mark.classList.toggle("is-active", selected);
        if (selected) mark.setAttribute("aria-current", "true");
        else mark.removeAttribute("aria-current");
      });
      applyMorphNames();

      word.textContent = project.name;
      name.textContent = project.name;
      description.textContent = project.description;

      copy.classList.remove("is-entering");
      if (!options.settled && !reducedMotion.matches) {
        requestAnimationFrame(() => copy.classList.add("is-entering"));
      }
    };

    // Coming back from a project page: land on the project the visitor just
    // left, and sit out the shared logo when the mark it morphs from is gone.
    document.addEventListener("portfolio:return", (event) => {
      const { slug, morph, transition } = event.detail ?? {};
      const index = fanProjects.findIndex((project) => project.slug === slug);

      morphEnabled = morph !== false;
      if (index >= 0) setActive(index, { settled: true });
      else applyMorphNames();

      if (morphEnabled) return;
      const restore = () => {
        morphEnabled = true;
        applyMorphNames();
      };
      if (transition) transition.finished.then(restore, restore);
      else restore();
    });

    marks.forEach((mark, index) => {
      // The mark in front is a plain link. The ones behind it step forward first.
      mark.addEventListener("click", (event) => {
        if (didSwipe) {
          didSwipe = false;
          event.preventDefault();
          return;
        }
        if (index === active) return;
        event.preventDefault();
        setActive(index);
      });
      // Tabbing onto a mark brings it forward, so Enter opens what is focused.
      mark.addEventListener("focus", () => {
        if (index !== active && mark.matches(":focus-visible")) setActive(index);
      });
    });

    fan.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActive(active - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        setActive(active + 1);
      }
    });

    gesture.addEventListener("pointerdown", (event) => {
      pointerStart = event.clientX;
      didSwipe = false;
      gesture.setPointerCapture?.(event.pointerId);
    });
    gesture.addEventListener("pointermove", (event) => {
      if (pointerStart === null) return;
      didSwipe = Math.abs(event.clientX - pointerStart) > 34;
    });
    gesture.addEventListener("pointerup", (event) => {
      if (pointerStart === null) return;
      const distance = event.clientX - pointerStart;
      pointerStart = null;
      didSwipe = Math.abs(distance) > 34;
      if (didSwipe) setActive(active + (distance < 0 ? 1 : -1));
      window.setTimeout(() => {
        didSwipe = false;
      }, 0);
    });
    gesture.addEventListener("pointercancel", () => {
      pointerStart = null;
      didSwipe = false;
    });
  })();
</script>

<style>
  .project-fan {
    display: none;
  }

  @media (max-width: 620px) {
    .project-stack--desktop {
      display: none;
    }

    .project-fan {
      --fan-ease: cubic-bezier(0.22, 1, 0.36, 1);
      width: min(100%, 360px);
      height: 340px;
      position: relative;
      display: block;
      overflow: hidden;
      contain: layout paint;
      text-align: left;
      touch-action: pan-y;
    }

    .project-fan__word {
      position: absolute;
      top: 34px;
      left: 50%;
      color: var(--surface);
      font-size: clamp(4.8rem, 23vw, 6.3rem);
      font-weight: 760;
      line-height: 0.8;
      transform: translateX(-50%);
      white-space: nowrap;
    }

    .project-fan__stage {
      height: 340px;
      position: relative;
      display: grid;
      grid-template-rows: 206px 1fr;
      cursor: grab;
    }

    .project-fan__stage:active {
      cursor: grabbing;
    }

    .project-fan__marks {
      position: relative;
      isolation: isolate;
    }

    .project-fan__mark {
      width: 112px;
      height: 112px;
      position: absolute;
      top: 52%;
      left: 50%;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 0;
      border-radius: 28px;
      background: transparent;
      padding: 0;
      user-select: none;
      -webkit-touch-callout: none;
      -webkit-tap-highlight-color: transparent;
      opacity: 0.46;
      filter: grayscale(1);
      transform: translate3d(-50%, -50%, 0);
      transition:
        transform 560ms var(--fan-ease),
        opacity 300ms var(--fan-ease),
        filter 300ms var(--fan-ease);
      will-change: transform;
    }

    .project-fan__mark img {
      width: 100%;
      height: 100%;
      border-radius: inherit;
      object-fit: cover;
      pointer-events: none;
    }

    .project-fan__mark[data-offset="-1"] {
      z-index: 1;
      transform: translate3d(calc(-50% - 82px), calc(-50% + 18px), 0) rotate(-12deg) scale(0.72);
    }

    .project-fan__mark[data-offset="1"] {
      z-index: 2;
      transform: translate3d(calc(-50% + 82px), calc(-50% + 16px), 0) rotate(10deg) scale(0.76);
    }

    .project-fan__mark[data-offset="0"] {
      z-index: 4;
      opacity: 1;
      filter: grayscale(0);
      transform: translate3d(-50%, calc(-50% - 8px), 0) rotate(0) scale(1.08);
    }

    .project-fan__mark:focus-visible {
      z-index: 6;
      outline-offset: 5px;
    }

    .project-fan__copy {
      z-index: 5;
      display: grid;
      justify-items: center;
      align-content: start;
      padding: 0 18px 20px;
      text-align: center;
    }

    .project-fan__copy.is-entering {
      animation: project-fan-copy 420ms var(--fan-ease) both;
    }

    .project-fan__copy strong {
      font-size: 1.65rem;
      font-weight: 650;
      line-height: 1;
    }

    .project-fan__copy > span {
      margin-top: 6px;
      color: var(--muted);
      font-size: 0.8rem;
    }

  }

  @keyframes project-fan-copy {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-fan__mark {
      transition: none;
      will-change: auto;
    }

    .project-fan__copy.is-entering {
      animation: none;
    }
  }
</style>
