---
import * as simpleIcons from "simple-icons";
import { emailHref, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

type Tool = {
  name: string;
  use: string;
  icon?: string;
  image?: string;
  mark?: string;
  href?: string;
  accent: string;
};

const iconFor = (key?: string): { path: string } | null => {
  if (!key) return null;
  const icon = (simpleIcons as unknown as Record<string, { path: string } | undefined>)[key];
  return icon ?? null;
};

const dailyTools: Tool[] = [
  {
    name: "Codex",
    use: "my AI coding agent of choice; the app is great, and the limits are generous",
    image: "/tools/codex.svg",
    href: "https://openai.com/codex/get-started/",
    accent: "#10a37f",
  },
  {
    name: "cmux",
    use: "my preferred terminal",
    image: "/tools/cmux.png",
    href: "https://cmux.com/",
    accent: "#3989f7",
  },
  {
    name: "Zen Browser",
    use: "my preferred browser: open source, with a great UI, sidebar tabs, spaces, and more",
    icon: "siZenbrowser",
    href: "https://zen-browser.app/",
    accent: "#f76f53",
  },
  {
    name: "Kriyan",
    use: "my second brain, productivity app, and personal agent",
    image: "/logos/kriyan-icon.svg",
    href: "https://github.com/kausthubh-coder/kriyan",
    accent: "#6c6c6c",
  },
  {
    name: "Oracle",
    use: "my workflow skill for Codex",
    image: "/tools/oracle.svg",
    href: "https://www.skills.sh/kausthubh-coder/oracle-skill/oracle",
    accent: "#7c4dff",
  },
];

const appTools: Tool[] = [
  {
    name: "Convex",
    use: "the best backend-as-a-service I have used",
    icon: "siConvex",
    href: "https://www.convex.dev/",
    accent: "#ee342f",
  },
  {
    name: "PostHog",
    use: "my analytics choice; it is easy to set up and has a generous free tier",
    icon: "siPosthog",
    href: "https://posthog.com/",
    accent: "#f7a501",
  },
  {
    name: "Next.js",
    use: "my framework for web development",
    icon: "siNextdotjs",
    href: "https://nextjs.org/",
    accent: "#111111",
  },
  {
    name: "Tauri",
    use: "my preferred choice for native desktop apps",
    icon: "siTauri",
    href: "https://tauri.app/",
    accent: "#24c8d8",
  },
  {
    name: "Vercel",
    use: "the best way to deploy web apps",
    icon: "siVercel",
    href: "https://vercel.com/",
    accent: "#111111",
  },
  {
    name: "Clerk",
    use: "easy, solid authentication with a good new free tier and great Convex integration",
    icon: "siClerk",
    href: "https://clerk.com/",
    accent: "#6c47ff",
  },
  {
    name: "Autumn",
    use: "the easiest billing service I have tried",
    image: "/tools/autumn.svg",
    href: "https://www.useautumn.com/",
    accent: "#8838ff",
  },
];

const sections = [
  { id: "daily", title: "what I use every day", tools: dailyTools, offset: 0 },
  { id: "apps", title: "what I build products with", tools: appTools, offset: dailyTools.length },
];

const updated = new Date(`${site.workflowUpdated}T12:00:00Z`);
const updatedLabel = updated.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title={`Stack + AI workflow | ${site.name}`}
  description="The tools, services, and AI workflow Kausthubh uses to think, build, and ship products."
>
  <main class="detail-page tools-page">
    <a href="/" class="tools-back"><span aria-hidden="true">&larr;</span> home</a>

    <header class="tools-intro">
      <img src="/logo.webp" alt="" width="56" height="56" />
      <div>
        <p class="tools-kicker">my setup</p>
        <h1>tools</h1>
      </div>
      <p>
        The software, services, and systems I keep reaching for. This is the short version for now; I will add the
        deeper why behind each choice as the stack changes.
      </p>
      <p class="tools-updated">last updated <time datetime={site.workflowUpdated}>{updatedLabel}</time></p>
    </header>

    {
      sections.map((section) => (
        <section class={`tools-section tools-section--${section.id}`} aria-labelledby={`${section.id}-tools-title`}>
          <h2 id={`${section.id}-tools-title`}>{section.title}</h2>
          <ul class="tools-list">
            {section.tools.map((tool, index) => {
              const icon = iconFor(tool.icon);
              return (
                <li class="tools-item" style={`--tool-accent: ${tool.accent}; --tool-index: ${index + section.offset};`}>
                  <span class="tools-icon" aria-hidden="true">
                    {tool.image ? (
                      <img src={tool.image} alt="" width="38" height="38" loading="lazy" />
                    ) : icon ? (
                      <svg viewBox="0 0 24 24"><path d={icon.path} /></svg>
                    ) : (
                      <span class="tools-mark">{tool.mark}</span>
                    )}
                  </span>
                  <div class="tools-copy">
                    <h3>
                      {tool.href ? <a href={tool.href} target="_blank" rel="noreferrer">{tool.name}</a> : tool.name}
                    </h3>
                    <p><span aria-hidden="true">&#8627;</span>{tool.use}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <footer class="tools-footer">
      <span>still changing, still shipping.</span>
      <a href={emailHref}>tell me what I am missing</a>
    </footer>
  </main>
</BaseLayout>
